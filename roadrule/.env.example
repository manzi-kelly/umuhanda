# Server-only administrator gateway configuration. No credentials go in this file.
ADMIN_API_ORIGIN=http://127.0.0.1:8000
ADMIN_FRONTEND_ORIGIN=http://localhost:3000
# Required only when testing `next start` over loopback HTTP; rejected for public hosts.
ADMIN_LOCAL_DEVELOPMENT=1

# Match the API ingress cap for the same-origin admin PDF bridge.
PDF_MAX_FILE_BYTES=26214400
