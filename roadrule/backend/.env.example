APP_ENV=development
APP_NAME=Road Rules API
# Populate with dedicated credentials; never commit the resulting .env.
# postgresql+psycopg://roadrules_dev_app:<URL-encoded-password>@127.0.0.1:55432/roadrules_dev
DATABASE_URL=
# postgresql+psycopg://roadrules_test_app:<URL-encoded-password>@127.0.0.1:55432/roadrules_test
TEST_DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
GUEST_SESSION_LIFETIME_SECONDS=7200
GUEST_SESSION_IDLE_SECONDS=1800
GUEST_SESSION_TOUCH_SECONDS=60
GUEST_COOKIE_SAMESITE=lax
SESSION_CREATION_LIMIT=30
SESSION_CREATION_WINDOW_SECONDS=60

# Admin sessions: 8 hours absolute, 30 minutes idle; durable global login budget.
ADMIN_SESSION_LIFETIME_SECONDS=28800
ADMIN_SESSION_IDLE_SECONDS=1800
ADMIN_SESSION_TOUCH_SECONDS=60
ADMIN_LOGIN_LIMIT=20
ADMIN_LOGIN_WINDOW_SECONDS=60

# PDF storage is private. API and worker must use the same absolute directory.
# Optional in development. In deployments, use the same persistent private
# mount for the API and PDF worker. The directory contains sources and assets.
# PDF_STORAGE_ROOT=/var/lib/roadrules/pdf-storage
PDF_MAX_FILE_BYTES=26214400
PDF_MAX_PAGES=600
PDF_MAX_PAGE_POINTS=2000
PDF_MAX_PAGE_CHARS=50000
PDF_MAX_QUESTIONS=2000
PDF_UPLOAD_LIMIT=10
PDF_UPLOAD_WINDOW_SECONDS=3600
PDF_JOB_TIMEOUT_SECONDS=300
PDF_WORKER_MEMORY_MB=512
# Optional local Tesseract traineddata directory. OCR output always requires review.
# PDF_OCR_TESSDATA=D:/path/to/tessdata
PDF_OCR_LANGUAGE=kin

# Explicitly choose UNSTRATIFIED before importing sources without reliable difficulty tags.
EXAM_SELECTION_POLICY=DIFFICULTY_BALANCED
EXAM_CATEGORY_ROAD_SIGN_COUNT=1

MOCK_PAYMENTS_ENABLED=false
MOCK_EXAM_AMOUNT_RWF=500
